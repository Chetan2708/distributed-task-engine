# Database credentials
DB_PASSWORD=your_secure_password_here

# You can add other environment variables here if needed
# Authentication Credentials
JOBFLOW_AUTH_USER_PASSWORD=secure_user_password
JOBFLOW_AUTH_ADMIN_PASSWORD=secure_admin_password

# JWT Settings
JOBFLOW_JWT_SECRET=your_base64_encoded_secure_jwt_secret_here_must_be_256_bits
JOBFLOW_JWT_EXPIRATION_MS=36000000

# Other settings
# SPRING_PROFILES_ACTIVE=prod
