# Database credentials
DB_PASSWORD=your_secure_password_here

# Authentication credentials
JOBFLOW_AUTH_USER_USERNAME=user
JOBFLOW_AUTH_USER_PASSWORD=replace_with_a_strong_password

JOBFLOW_AUTH_ADMIN_USERNAME=admin
JOBFLOW_AUTH_ADMIN_PASSWORD=replace_with_a_different_strong_password

# JWT signing secret: use a securely generated key of at least 32 bytes
JOBFLOW_JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
JOBFLOW_JWT_EXPIRATION_MS=36000000

# Frontend
APP_FRONTEND_URL=http://localhost:5173